# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Docker registry ──────────────────────────────────────────────────────────
# Hostname of the Docker registry where built images are pushed and pulled.
# Example: registry.example.com  or  localhost:5000  (local dev registry)
DOCKER_REGISTRY=
DOCKER_USER=
DOCKER_PASSWORD=

# ── Jenkins ──────────────────────────────────────────────────────────────────
# Substituted into docker/jenkins/jenkins.yaml (JCasC) at container startup.
JENKINS_ADMIN_PASSWORD=

# ── SonarQube ────────────────────────────────────────────────────────────────
# Base URL of the SonarQube server used for static-analysis scans.
SONAR_HOST_URL=http://localhost:9000
# Token generated in SonarQube → My Account → Security → Generate Token.
SONAR_TOKEN=

# ── Slack ────────────────────────────────────────────────────────────────────
# Bot token for the Jenkins Slack plugin (xoxb-...).
SLACK_TOKEN=
# Workspace subdomain (e.g., "my-team" for my-team.slack.com).
SLACK_WORKSPACE=
# Optional incoming webhook for ad-hoc notifications.
SLACK_WEBHOOK_URL=

# ── Kubernetes ───────────────────────────────────────────────────────────────
# Path to the kubeconfig used by kubectl in setup.sh and Jenkins agents.
KUBECONFIG=

# ── Application database ─────────────────────────────────────────────────────
# Used by scripts/setup.sh when creating the my-app-secrets Kubernetes secret.
DB_HOST=
DB_PASSWORD=

# ── App runtime ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
