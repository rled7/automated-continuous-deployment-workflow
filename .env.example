# ─────────────────────────────────────────────────────────────────────────────
# .env.example — copy to .env and fill in real values before running locally.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# URL of the Docker registry where built images are pushed and pulled.
# Example: registry.example.com  or  localhost:5000  (local dev registry)
DOCKER_REGISTRY_URL=

# Base URL of the SonarQube server used for static-analysis scans.
# Example: http://localhost:9000  or  https://sonar.example.com
SONAR_HOST_URL=

# Authentication token for SonarQube API access.
# Generate one in SonarQube → My Account → Security → Generate Token.
SONAR_TOKEN=

# Incoming Webhook URL for Slack build/deploy notifications.
# Create one at https://api.slack.com/apps → Incoming Webhooks.
SLACK_WEBHOOK_URL=

# Path to the kubeconfig file used by kubectl / Helm for cluster access.
# Example: /home/user/.kube/config
KUBECONFIG=

# Node.js runtime environment. Typical values: development | test | production
NODE_ENV=development

# TCP port the application server listens on.
PORT=3000
