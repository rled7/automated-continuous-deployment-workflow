{
  "name": "jenkins-cicd-app",
  "version": "1.0.0",
  "scripts": {
    "lint": "eslint \"src/**/*.js\"",
    "build": "cp -r src dist",
    "test": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=unit",
    "test:integration": "NODE_ENV=test NODE_OPTIONS=--experimental-vm-modules jest --testPathPatterns=integration",
    "test:smoke": "jest smoke/smoke.test.js",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:mutation": "stryker run",
    "start": "node dist/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "knex --knexfile=knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile=knexfile.js migrate:rollback",
    "migrate:make": "knex --knexfile=knexfile.js migrate:make"
  },
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.81.0",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.0.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.0",
    "knex": "^3.1.0",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^10.0.0",
    "prom-client": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@playwright/test": "^1.49.0",
    "@stryker-mutator/core": "^8.7.0",
    "@stryker-mutator/jest-runner": "^8.7.0",
    "eslint": "^8.57.0",
    "eslint-plugin-jest": "^27.9.0",
    "jest": "^30.3.0",
    "jest-junit": "^16.0.0",
    "nodemon": "^3.1.14",
    "pg-mem": "^3.0.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.0.0"
  },
  "type": "module"
}
