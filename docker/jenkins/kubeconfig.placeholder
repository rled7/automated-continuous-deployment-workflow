# Placeholder mounted at /run/secrets/kubeconfig when KUBECONFIG is not set in
# .env. The kubeconfig credential in jenkins.yaml must have content or Jenkins
# refuses to start; with this file it starts, and deploy stages fail with a
# clear "no cluster" error until a real kubeconfig is provided.
apiVersion: v1
kind: Config
clusters: []
contexts: []
users: []
